<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- the list: every pixel is items; the two round buttons float over the corners -->
    <FrameLayout
        android:id="@+id/list_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Nothing on your list."
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <!-- top right: open (the widget's settings first, unless that is turned off there) -->
        <ImageView
            android:id="@+id/open"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/widget_fab_bg"
            android:contentDescription="Open"
            android:padding="8dp"
            android:src="@drawable/ic_w_open" />

        <!-- bottom right: refresh; while it runs a spinner takes its place -->
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/widget_fab_bg"
            android:contentDescription="Refresh"
            android:padding="8dp"
            android:src="@drawable/ic_w_refresh" />

        <ProgressBar
            android:id="@+id/refresh_spin"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="4dp"
            android:background="@drawable/widget_fab_bg"
            android:indeterminate="true"
            android:indeterminateTint="@color/widget_accent"
            android:padding="7dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- one item opened up: it takes the whole widget (no list, no scrolling). A tap on the text closes it; the only way into the app is the open button on the list. -->
    <FrameLayout
        android:id="@+id/detail_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/detail_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:paddingEnd="96dp"
                android:textColor="@color/widget_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detail_desc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- floating over the text: top right, Complete (Archive for a tag's notes); bottom right, Send to tags (Send to tasks) -->
        <TextView
            android:id="@+id/detail_done"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Complete"
            android:textColor="@color/widget_btn_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_send"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/widget_pill_secondary"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Send to tags"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
