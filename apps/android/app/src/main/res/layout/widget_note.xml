<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="44dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:text="Tap the open button to choose a note."
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/open"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/widget_fab_bg"
        android:contentDescription="Open"
        android:padding="9dp"
        android:src="@drawable/ic_w_open" />

    <ImageView
        android:id="@+id/refresh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/widget_fab_bg"
        android:contentDescription="Refresh"
        android:padding="9dp"
        android:src="@drawable/ic_w_refresh" />

    <ProgressBar
        android:id="@+id/refresh_spin"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/widget_fab_bg"
        android:indeterminate="true"
        android:indeterminateTint="@color/widget_accent"
        android:padding="8dp"
        android:visibility="gone" />
</FrameLayout>
